# Rasa API credentials
# Copy this file to `.env` in the same folder and fill in your own keys.
#
#   cp .env.example .env
#
# TMDB (The Movie Database) - powers film & TV metadata, credits, posters.
# Free API key: https://www.themoviedb.org/settings/api  (create a free account,
# request an API key, then copy the "API Read Access Token" below).
# Only ONE of the two values is required; the read token is preferred.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# No keys needed for the other data sources:
#   Jikan (MyAnimeList) - https://jikan.moe        (public, rate-limited)
#   AniList             - https://anilist.co       (public GraphQL)
#   MangaDex            - https://api.mangadex.org (public, rate-limited)
